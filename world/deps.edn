{:paths ["src" "resources"]
 :deps {org.clojure/clojure        {:mvn/version "1.12.6"}
        knowledge/schema           {:local/root "../schema"}
        metosin/malli              {:mvn/version "0.20.2"}
        datascript/datascript      {:mvn/version "1.8.1"}
        http-kit/http-kit          {:mvn/version "2.8.1"}
        com.cognitect/transit-clj  {:mvn/version "1.1.363"}
        metosin/jsonista           {:mvn/version "0.3.14"}
        com.taoensso/timbre        {:mvn/version "6.8.0"}
        org.jetbrains.pty4j/pty4j  {:mvn/version "0.13.10"}}
 :aliases
 {:dev   {:extra-paths ["dev" "test"]
          :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.1"}
                       org.clojure/test.check      {:mvn/version "1.1.3"}}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
  :test  {:extra-paths ["test"]
          :extra-deps {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
          :main-opts ["-m" "kaocha.runner"]}
  :run   {:main-opts ["-m" "knowledge.world.main"]}}}
