# copy to .envrc (git-ignored) and fill in. Any OpenAI-compatible chat endpoint works.
export KE_MODEL_URL=http://localhost:8000/v1
export KE_MODEL_ID=your-model-name
export KE_MODEL_KEY=your-key            # the endpoint's key, or anything if it takes none
export KE_PORT=7777
export KE_DATA=./data
export KE_FSYNC=batch                   # batch | always | never
# export KE_PUBLIC_URL=ws://your-host:7777/ws   # what clients are told to dial, for pairing
# export KE_TECTONIC=/path/to/tectonic  # TeX rendering; else tectonic on PATH
